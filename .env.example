# =========================================================================
# ToolBoxJP — 環境変数
# .env.local にコピーして値を入れてください（.env.local は git に載りません）
# =========================================================================

# サイト基本設定（本番URLに変更すること）
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_DESCRIPTION=

# Google AdSense（取得後に設定）
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_ENABLED=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=

# Google Analytics 4（測定ID。akamaru-ceo 側 GA4Provider が使う GA4_PROPERTY_ID とは
# 別物だが、同一の GA4 プロパティを指している必要がある）
NEXT_PUBLIC_GA_ID=

# Revenue Experiment（Phase Revenue 0）Waitlist送信先
# app/contact/ContactForm.tsx と同じ「Google Formへの無音送信」方式。
# 未設定の間はWaitlistFormがメール入力欄自体を表示しない（送信データの消失を防ぐため）。
# 作成手順: 1) Google Formを新規作成し、メールアドレス欄・商品名欄(自由記述)を用意する
#          2) フォームのプレビューを開き、開発者ツールで各inputのname属性(entry.xxxxxxxxxx)を控える
#          3) フォームURLの末尾を "/viewform" → "/formResponse" に置き換えたものをFORM_URLに設定する
NEXT_PUBLIC_WAITLIST_FORM_URL=
NEXT_PUBLIC_WAITLIST_ENTRY_EMAIL=
NEXT_PUBLIC_WAITLIST_ENTRY_PRODUCT=
